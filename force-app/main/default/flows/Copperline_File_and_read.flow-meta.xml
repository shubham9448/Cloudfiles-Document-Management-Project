    <decisions>
        <name>Is_it_one_of_ours</name>
        <label>Is it one of ours</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmIsOurs</leftValueReference>
