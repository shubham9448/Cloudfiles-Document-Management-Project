    <environments>Default</environments>
    <formulas>
        <name>frmDocumentType</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS(UPPER({!varClassification}), &quot;INVOICE&quot;), &quot;Supplier Invoice&quot;,
IF(CONTAINS(UPPER({!varClassification}), &quot;APPLICATION&quot;), &quot;Application Form&quot;,
IF(CONTAINS(UPPER({!varClassification}), &quot;IDENTITY&quot;), &quot;Identity Document&quot;,
IF(CONTAINS(UPPER({!varClassification}), &quot;AGREEMENT&quot;), &quot;Agreement&quot;, &quot;Other&quot;))))</expression>
    </formulas>
    <formulas>
        <name>frmIsLicence</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(UPPER({!varIsLicenceAnswer}), &quot;YES&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmIsOurs</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!Get_Event_Detail.DocumentProcessed.Context}, &quot;copperline-deal:&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmTargetFolderId</name>
        <dataType>String</dataType>
        <expression>CASE({!frmDocumentType},
  &quot;Supplier Invoice&quot;, {!Get_Related_Document.Opportunity__r.Supplier_Invoice_Folder_Id__c},
  &quot;Application Form&quot;, {!Get_Related_Document.Opportunity__r.Application_Folder_Id__c},
  &quot;Identity Document&quot;, {!Get_Related_Document.Opportunity__r.Identity_Folder_Id__c},
  &quot;Agreement&quot;, {!Get_Related_Document.Opportunity__r.Agreement_Folder_Id__c},
  {!Get_Related_Document.Opportunity__r.Others_Folder_Id__c})</expression>
    </formulas>
